{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "casak-vanaheim.vercel.app" }],
      "destination": "https://www.vanaheim-news.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "casak-vanaheim.vercel.app" }],
      "destination": "https://www.vanaheim-news.cz/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "casak-vanaheim-git-main-vanaheim-news-projects.vercel.app" }],
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin",
      "missing": [{ "type": "host", "value": "casak-vanaheim-git-main-vanaheim-news-projects.vercel.app" }],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "missing": [{ "type": "host", "value": "casak-vanaheim-git-main-vanaheim-news-projects.vercel.app" }],
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
